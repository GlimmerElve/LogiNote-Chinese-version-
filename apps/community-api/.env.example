COMMUNITY_DATABASE_URL=postgresql://community:CHANGE_ME@127.0.0.1:5432/community
COMMUNITY_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
COMMUNITY_WEB_ORIGIN=http://127.0.0.1:5174
COMMUNITY_ALLOWED_ORIGINS=
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=5180
COMMUNITY_DATA_DIRECTORY=.data
COMMUNITY_GLOBAL_STORAGE_LIMIT_BYTES=0
COMMUNITY_MONTHLY_DOWNLOAD_LIMIT_BYTES=0
# RSS uses system DNS by default. The optional unauthenticated AliDNS HTTPS resolver is
# scoped to the fixed RSS catalog; it never changes OS DNS or allows private IPs.
COMMUNITY_RSS_DNS=system
# CloudBase hosts account registration, email verification and password recovery.
# Missing CloudBase configuration does not fall back to local authentication.
COMMUNITY_AUTH_PROVIDER=cloudbase
COMMUNITY_CLOUDBASE_ENV_ID=
COMMUNITY_CLOUDBASE_REGION=ap-shanghai
# Public auth REST uses environment + region; do not add cloud SecretId/SecretKey here.
# Legacy local-auth tests only: explicitly set COMMUNITY_AUTH_PROVIDER=local.
# CloudBase mode does not use these SMTP settings.
COMMUNITY_SMTP_HOST=
COMMUNITY_SMTP_PORT=587
COMMUNITY_SMTP_SECURE=false
COMMUNITY_SMTP_USER=
COMMUNITY_SMTP_PASSWORD=
COMMUNITY_SMTP_FROM=
