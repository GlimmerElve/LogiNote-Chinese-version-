{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:electron": "esbuild src/electron/main.ts --bundle --platform=node --format=cjs --packages=external --external:electron --outfile=dist-electron/main.cjs && esbuild src/electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "electron": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder --publish never",
    "publish": "npm run build && npm run build:electron && electron-builder --publish always"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/katex": "^0.16.8",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "3d-force-graph": "^1.80.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.3.9",
    "katex": "^0.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "unpdf": "^1.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
